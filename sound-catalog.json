{
  "schemaVersion": "1.0.0",
  "catalogVersion": "1.1.0",
  "name": "Ferman Sound Catalog",
  "status": "user-shortlisted-not-final-brand-approval",
  "baseUrl": "https://raw.githubusercontent.com/rezabahrami89/ferman-sound-catalog/main/",
  "credit": "Sound assets by Kenney",
  "packs": {
    "interface": {
      "directory": "kenney_interface-sounds/Audio/",
      "license": "CC0-1.0",
      "licensePath": "kenney_interface-sounds/License.txt"
    },
    "impact": {
      "directory": "kenney_impact-sounds/Audio/",
      "license": "CC0-1.0",
      "licensePath": "kenney_impact-sounds/License.txt"
    },
    "scifi": {
      "directory": "kenney_sci-fi-sounds/Audio/",
      "license": "CC0-1.0",
      "licensePath": "kenney_sci-fi-sounds/License.txt"
    }
  },
  "playbackPolicy": {
    "audioOptional": true,
    "silentAutoplay": true,
    "requireUserGestureToEnableAudio": true,
    "preloadOnlySelectedSounds": true,
    "onLoadOrDecodeFailure": "continue-silently",
    "clock": "shared-animation-clock",
    "stopActiveSoundsOnRestart": true,
    "allowSoundDuringFinalHold": false,
    "excludeNonAudioFiles": true
  },
  "sounds": [
    {
      "id": "ui-select",
      "pack": "interface",
      "file": "select_001.ogg",
      "events": ["selection", "highlight"],
      "reviewStatus": "user-shortlisted"
    },
    {
      "id": "panel-open",
      "pack": "interface",
      "file": "open_001.ogg",
      "events": ["panel-entry", "card-reveal"],
      "reviewStatus": "user-shortlisted"
    },
    {
      "id": "confirmation",
      "pack": "interface",
      "file": "confirmation_001.ogg",
      "events": ["success", "completion", "logo-reveal-candidate"],
      "reviewStatus": "user-shortlisted"
    },
    {
      "id": "metal-impact",
      "pack": "impact",
      "file": "impactMetal_medium_000.ogg",
      "events": ["metal-object-contact", "mechanical-lock"],
      "reviewStatus": "user-shortlisted"
    },
    {
      "id": "glass-impact",
      "pack": "impact",
      "file": "impactGlass_light_000.ogg",
      "events": ["glass-object-contact"],
      "reviewStatus": "user-shortlisted"
    },
    {
      "id": "energy-reveal",
      "pack": "scifi",
      "file": "forceField_000.ogg",
      "events": ["energy-reveal", "hologram-entry"],
      "reviewStatus": "user-shortlisted"
    }
  ],
  "selectionPolicy": {
    "defaultStyle": "restrained",
    "useOnlyWhenMotivatedByVisualEvent": true,
    "avoidSoundOnEveryAnimatedElement": true,
    "doNotTreatEnergySoundsAsGenericWhooshes": true,
    "auditionBeforeBrandApproval": true,
    "measureDurationAndLoudnessBeforeFinalMix": true
  }
}
